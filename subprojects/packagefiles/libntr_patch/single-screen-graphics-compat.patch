 {
-    memcpy(dest, src, size);
+    MIi_StartHBlankDma(dmaNo, src, dest, size);
 }
 
 void MI_HBlankDmaCopy32If(u32 dmaNo, const void *src, void *dest, u32 size)
 {
-    memcpy(dest, src, size);
+    MIi_StartHBlankDma(dmaNo, src, dest, size);
