--- a/meson.build
+++ b/meson.build
@@ -103,6 +103,21 @@
 ############################################################
 nitrosdk_dep = dependency('NitroSDK')
 
+# Local simulator extensions are optional across libntr branches.
+if build_target == 'linux' or build_target == 'win64'
+    # Compiler probes cannot include the SDK until fx_const.h is generated.
+    sdk_fs = import('fs')
+    sdk_headers = meson.global_source_root() / 'subprojects/libntr/include/simulator'
+    if sdk_fs.read(sdk_headers / 'sim.h').contains('SIM_EncodeTextureAddress(')
+        nitrosystem_args += '-DLIBNTR_HAS_EXTENDED_TEXTURES'
+        add_project_arguments('-DLIBNTR_HAS_EXTENDED_TEXTURES', language: ['c', 'cpp'], native: true)
+    endif
+    if sdk_fs.read(sdk_headers / 'sim_audio.h').contains('SIM_Audio_SetPlayerFastForward(')
+        nitrosystem_args += '-DLIBNTR_HAS_PLAYER_FAST_FORWARD'
+        add_project_arguments('-DLIBNTR_HAS_PLAYER_FAST_FORWARD', language: ['c', 'cpp'], native: true)
+    endif
+endif
+
 ############################################################
 ###                      LIBRARIES                       ###
 ############################################################
